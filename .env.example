# AI Executive Team OS - Environment Configuration

# LLM Providers (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Default LLM
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini

# Supabase (optional - uses in-memory fallback without)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Search (optional)
TAVILY_API_KEY=
SERPAPI_KEY=

# Google Integrations (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# n8n Automation (optional)
N8N_WEBHOOK_URL=
N8N_API_KEY=

# Auth (NextAuth v5)
AUTH_SECRET=generate-with-openssl-rand-base64-32
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD_HASH=bcrypt-hash-of-your-password

# Disable auth for local dev (set to "true")
AUTH_DISABLED=false

# Demo mode (shows banner, shared API key, 10 req/min)
NEXT_PUBLIC_DEMO_MODE=false
DEMO_OPENAI_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
